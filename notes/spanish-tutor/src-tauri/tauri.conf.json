{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spanish Tutor",
  "version": "0.1.0",
  "identifier": "dev.freemocap.spanishtutor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Spanish Tutor",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
