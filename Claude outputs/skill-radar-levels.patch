+.skill-levels-row { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr) auto calc(48px * var(--layout-scale)) auto auto; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-2); background: none; border: 0; border-bottom: var(--border-width) solid var(--line-soft); border-radius: 0; text-align: start; font-size: var(--type-ui); cursor: pointer; }
