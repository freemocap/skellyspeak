+.skill-levels-dot { width: var(--space-4); height: var(--space-4); border-radius: var(--radius-pill); background: currentColor; }
+.skill-levels-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: var(--weight-medium); }
+.skill-levels-level { padding: 0 var(--space-2); border-radius: var(--radius-xs); background: var(--chrome); color: var(--ink); font-family: var(--font-mono); font-size: var(--type-meta); font-weight: var(--weight-semibold); }
+.skill-levels-row progress { width: 100%; }
+.skill-levels-points, .skill-levels-row-xp { color: var(--ink-3); font-family: var(--font-mono); font-size: var(--type-meta); font-variant-numeric: tabular-nums; }
+.skill-levels-row-xp { color: var(--ink-2); font-weight: var(--weight-semibold); }
+
+.skill-levels-legend { display: flex; align-items: center; gap: var(--space-4); margin: 0; color: var(--ink-2); font-size: var(--type-meta); }
+.skill-levels-legend-mark { flex: none; width: var(--space-8); height: var(--space-4); border: var(--border-width-strong) solid var(--ink-2); border-radius: var(--radius-xs); background: var(--chip); }
+/* What the pointed or pinned skill covers; the resting text says how to use the radar. */
+.skill-levels-focus { display: flex; flex-direction: column; gap: var(--space-1); min-height: calc(var(--type-body) * 3); padding: var(--space-4) var(--space-6); border: var(--border-width) solid var(--line-soft); border-radius: var(--radius-md); background: var(--sheet); color: var(--ink-3); font-size: var(--type-ui); line-height: var(--leading-snug); }
+.skill-levels-focus strong { font-weight: var(--weight-semibold); }
+.skill-levels-focus span { color: var(--ink-2); }
