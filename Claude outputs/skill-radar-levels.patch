+.skill-levels-band::-webkit-progress-value, .skill-levels-row progress::-webkit-progress-value { background: currentColor; border-radius: var(--radius-pill); }
+.skill-levels-band::-moz-progress-bar, .skill-levels-row progress::-moz-progress-bar { background: currentColor; border-radius: var(--radius-pill); }
