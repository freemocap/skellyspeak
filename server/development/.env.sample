# Copy this file to server/.env and fill in the two provider keys.
# Everything else needed by the local server has a safe built-in default.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Dedicated audio service (select explicitly; never automatic fallback).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Transcription model is selected per request; Whisper is the app default.
# App Models: transcription=scribe_v2, read-aloud=eleven_v3.
