{
  "name": "skellyspeak-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node scripts/image-size-patch.mts --check && docusaurus start",
    "build": "node scripts/image-size-patch.mts --check && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "postinstall": "node scripts/image-size-patch.mts --apply",
    "security:check": "node scripts/image-size-patch.mts --check",
    "security:test": "node --test scripts/image-size-patch.test.mts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@freemocap/skellydocs": "^0.3.16",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "serialize-javascript": "7.1.1",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.0",
    "image-size": "2.0.2"
  }
}
