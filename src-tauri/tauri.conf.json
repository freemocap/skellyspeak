{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkellySpeak",
  "identifier": "org.skellyspeak.practice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SkellySpeak",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/128x128.png"] }
}
