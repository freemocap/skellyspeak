{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "due_recall": {
      "format": "double",
      "type": "number"
    },
    "failure_shrink": {
      "format": "double",
      "type": "number"
    },
    "initial_half_life_days": {
      "format": "double",
      "type": "number"
    },
    "initial_rating": {
      "format": "double",
      "type": "number"
    },
    "learning_rate": {
      "format": "double",
      "type": "number"
    },
    "max_half_life_days": {
      "format": "double",
      "type": "number"
    },
    "min_half_life_days": {
      "format": "double",
      "type": "number"
    },
    "minimum_independent_observations": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "success_growth": {
      "format": "double",
      "type": "number"
    },
    "support": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "type": "object"
    },
    "version": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "due_recall",
    "failure_shrink",
    "initial_half_life_days",
    "initial_rating",
    "learning_rate",
    "max_half_life_days",
    "min_half_life_days",
    "minimum_independent_observations",
    "sources",
    "success_growth",
    "support",
    "version"
