{
  "name": "skellyspeak",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "macos:dev-bundle": "node scripts/macos-dev.ts bundle",
    "macos:dev-sign": "node scripts/macos-dev.ts sign",
    "macos:dev": "node scripts/macos-dev.ts launch",
    "contracts": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-contracts",
    "contracts:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-contracts -- --check",
    "styles:check": "node scripts/check-styles.ts"
  },
  "dependencies": {
