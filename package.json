{
  "name": "skellyspeak",
  "private": true,
  "type": "module",
  "scripts": {
    "macos:dev": "node scripts/macos-dev.ts launch",
    "macos:dev-bundle": "node scripts/macos-dev.ts bundle",
    "macos:dev-sign": "node scripts/macos-dev.ts sign",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "contracts": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-contracts",
    "contracts:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-contracts -- --check",
    "styles:check": "node scripts/check-styles.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.0.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
