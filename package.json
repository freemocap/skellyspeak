{
  "name": "skellyspeak",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "docs:test": "vitest run --config vitest.docs.config.ts",
    "tauri": "tauri",
    "macos:dev-bundle": "node scripts/dev-run.ts bundle",
    "macos:dev-sign": "node scripts/dev-run.ts sign",
    "macos:dev": "node scripts/dev-run.ts launch",
    "contracts": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-contracts",
    "contracts:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-contracts -- --check",
    "styles:check": "node scripts/check-styles.ts",
    "styles:dead": "node scripts/prune-styles.ts",
    "styles:prune": "node scripts/prune-styles.ts --write",
    "server:local": "node scripts/dev-run.ts server",
    "logs:test": "node --test scripts/run-log.test.ts",
    "logs:check": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --allowImportingTsExtensions scripts/run-log.ts scripts/dev-run.ts scripts/run-log.test.ts",
    "graph": "node scripts/import-graph.ts",
    "move": "node scripts/refactor-move.ts",
    "graph:check": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --allowImportingTsExtensions scripts/import-graph.ts scripts/refactor-move.ts scripts/prune-styles.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "license": "AGPL-3.0-or-later"
}
