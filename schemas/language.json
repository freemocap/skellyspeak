{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Guidance": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "sources",
        "text"
      ],
      "type": "object"
    },
    "PersonaDetails": {
      "additionalProperties": false,
      "properties": {
        "age": {
          "description": "Left blank until someone chooses one.",
          "format": "uint8",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "background": {
          "type": "string"
        },
        "currentSituation": {
          "type": "string"
        },
        "favoriteBooks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "favoriteMovies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "interestingFacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "interests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "location": {
          "type": "string"
        },
        "manner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "occupation": {
          "type": "string"
        },
        "opinions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "quirks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "romanizedName": {
          "description": "The name in Latin letters, present exactly when the persona's language has a romanization system.",
          "type": [
            "string",
            "null"
          ]
        },
        "vibe": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "background",
        "currentSituation",
        "favoriteBooks",
        "favoriteMovies",
        "interestingFacts",
        "interests",
        "location",
        "manner",
        "name",
        "occupation",
        "opinions",
        "quirks",
        "vibe"
      ],
      "type": "object"
    },
    "ScalarOverrides": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "font_scale": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "word_spacing": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Variety": {
      "additionalProperties": false,
      "properties": {
        "guidance": {
          "items": {
            "$ref": "#/definitions/Guidance"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scalars": {
          "allOf": [
            {
              "$ref": "#/definitions/ScalarOverrides"
            }
          ],
          "default": {
            "direction": null,
            "font_scale": null,
            "word_spacing": null
          }
        }
      },
      "required": [
        "guidance",
        "id",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "default_variety": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "guidance": {
      "items": {
        "$ref": "#/definitions/Guidance"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "native_name": {
      "type": "string"
    },
    "orthography": {
      "type": "string"
    },
    "review": {
      "type": "string"
    },
    "romanization": {
      "type": [
        "string",
        "null"
      ]
    },
    "scalars": {
      "allOf": [
        {
          "$ref": "#/definitions/ScalarOverrides"
        }
      ],
      "default": {
        "direction": null,
        "font_scale": null,
        "word_spacing": null
      }
    },
    "script": {
      "type": "string"
    },
    "starter_persona": {
      "$ref": "#/definitions/PersonaDetails"
    },
    "traits": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "varieties": {
      "items": {
        "$ref": "#/definitions/Variety"
      },
      "type": "array"
    }
  },
  "required": [
    "default_variety",
    "family",
    "guidance",
    "id",
    "name",
    "native_name",
    "orthography",
    "review",
    "script",
    "starter_persona",
    "traits",
    "varieties"
  ],
  "title": "Language",
  "type": "object"
}
