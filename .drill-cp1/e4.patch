+    #[test]
+    fn silence_sits_at_the_floor_and_a_tone_lifts_only_its_own_band() {
+        let rate = 16000;
+        let silence = spectrogram(&vec![0; rate as usize], rate);
+        assert!(
+            silence.bins.iter().flatten().all(|db| *db == Some(-100.0)),
+            "digital silence must read as the floor"
